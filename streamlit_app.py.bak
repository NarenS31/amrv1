"""
Local Research Dashboard: AMR Prediction with Uncertainty (single-file)
NIH-grade constraints (best-effort in one file):
- Reproducibility panel always visible (versions, hashes, seed, timestamp)
- Deterministic seeding for sampling (best-effort)
- Explicit data provenance + transform log (raw -> processed -> analyzed)
- Scientific tone, no marketing language
- Figures include title/units + captions + interpretation text
- Config-driven (no magic numbers scattered)
- Exports: figures (HTML) + aggregate tables (CSV) + report summary (TXT)

NOTE: True NIH-grade expects multi-file separation + tests. This is the least-bad single-file variant.
"""
from __future__ import annotations
from diffusion_model import ConditionalDiffusionModel, DiffusionSchedule
from masked_autoencoder import MaskedAutoencoder

