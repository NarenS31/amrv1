    st.subheader("Transformations (raw → processed → analyzed)")
    st.write(
        "Transformations are explicit and logged at inference time (see In silico).")

    st.subheader("Models")
    st.write("- Masked autoencoder: used to produce robust embeddings (training not executed inside this app).")
    st.write(
        "- Diffusion model: used for sampling predictive distributions over classes.")
    st.write("- Schedule: fixed number of diffusion steps from config.")

    st.subheader("Determinism")
    st.write("- Sampling uses explicit seeds; deterministic behavior is best-effort due to framework/runtime constraints.")
    st.write("- Hashes for model and data artifacts are shown in the sidebar.")

elif section == "Results":
    st.header("Results")

    if not data_ok:
        st.stop()

    if artifacts.comparison is None:
        st.warning(
            "Comparison CSV not found. Provide results/final_comparison.csv to enable this section.")
    else:
        comparison = artifacts.comparison.copy()

        st.subheader("Aggregate metrics")
        c1, c2, c3, c4 = st.columns(4)
        with c1:
            st.metric("AMRFinder recall (mean)",
                      f"{comparison['amrfinder_recall'].mean():.3f}")
        with c2:
            st.metric("Pipeline 1 AUROC (mean)",
                      f"{comparison['pipeline1_auroc'].mean():.3f}")
        with c3:
            delta = (comparison["pipelineA_auroc"].mean() -
                     comparison["pipeline1_auroc"].mean()) * 100
            st.metric("Pipeline A AUROC (mean)",
                      f"{comparison['pipelineA_auroc'].mean():.3f}", f"{delta:+.1f}%")
        with c4:
            st.metric("Pipeline A recall (mean)",
                      f"{comparison['pipelineA_recall'].mean():.3f}")

        fig = fig_recall_by_antibiotic(comparison)
        st.plotly_chart(fig, use_container_width=True)
        st.markdown(
            "<div class='caption'><b>Caption:</b> Recall by antibiotic for two methods. "
            "Interpretation requires consistent phenotype mapping rules and sample counts per antibiotic.</div>",
            unsafe_allow_html=True,
        )

        st.subheader("Detailed table")
        display_df = comparison[
            ["antibiotic", "n_samples", "amrfinder_recall",
                "pipeline1_auroc", "pipelineA_auroc"]
        ].copy()
        display_df.columns = [
            "Antibiotic", "N", "AMRFinder recall", "Pipeline 1 AUROC", "Pipeline A AUROC"]
        st.dataframe(display_df.sort_values("Pipeline A AUROC",
                     ascending=False), use_container_width=True, hide_index=True)

        export_dir = ensure_export_dir(CONFIG)
        if st.button("Export results table (CSV)"):
            out = export_dir / "results_table.csv"
            export_table_csv(display_df, out)
            st.success(f"Exported: {out}")

        if st.button("Export recall figure (HTML)"):
            out = export_dir / "recall_by_antibiotic.html"
            export_figure_html(fig, out)
            st.success(f"Exported: {out}")

    st.subheader("Robustness under simulated missingness")
    corr = CONFIG["robustness"]["corruption_levels"]
    std = CONFIG["robustness"]["standard_ae_auroc"]
    msk = CONFIG["robustness"]["masked_ae_auroc"]

    fig2 = fig_robustness(corr, std, msk)
    st.plotly_chart(fig2, use_container_width=True)
    st.markdown(
        "<div class='caption'><b>Caption:</b> AUROC as a function of a defined corruption process "
        "(random removal of features, as implemented in your offline evaluation). "
        "Interpretation depends on whether corruption matches real assembly missingness.</div>",
        unsafe_allow_html=True,
    )

    export_dir = ensure_export_dir(CONFIG)
    if st.button("Export robustness figure (HTML)"):
        out = export_dir / "robustness_curve.html"
        export_figure_html(fig2, out)
        st.success(f"Exported: {out}")

elif section == "In silico":
    st.header("In silico inference (live)")
    st.write(
        "This section performs local inference using stored embeddings and diffusion sampling.")

    if not (data_ok and models_ok):
        st.stop()

    # Parameter sweep explorer (required)
    st.subheader("Sampling parameters")
    c1, c2, c3 = st.columns(3)
    with c1:
        n_samples = st.selectbox(
            "Number of samples", CONFIG["diffusion"]["allowed_samples"], index=2)
    with c2:
        seed = st.selectbox(
            "Sampling seed", CONFIG["diffusion"]["allowed_seeds"], index=3)
    with c3:
        genome_limit = int(CONFIG["ui"]["genome_dropdown_limit"])
        st.write(f"Genome list limit: {genome_limit}")

    st.subheader("Input selection")
    g = st.selectbox("Genome ID", artifacts.genome_ids[:genome_limit])

    # Important: do not pretend antibiotic-conditioning exists unless it actually does.
    antibiotic = st.selectbox(
        "Antibiotic (display only; not used in inference unless wired in model)", CONFIG["ui"]["antibiotics"])

    if st.button("Run inference"):
        idx = artifacts.id_to_idx[g]
        raw_emb = artifacts.embeddings[idx]

        # Explicit transformation pipeline + log
        tr = transform_embedding(raw_emb)

        st.subheader("Data provenance and transformations")
        st.write("Raw source: embeddings NPY row indexed by genome ID list.")
        st.dataframe(
            pd.DataFrame([{"step": i + 1, "name": r.name, "params": r.params,
                         "rationale": r.rationale} for i, r in enumerate(tr.log)]),
            use_container_width=True,
            hide_index=True,
        )

        mean_probs, std_probs = sample_predictive_distribution(
            diffusion=models.diffusion,
            schedule=models.schedule,
            embedding=tr.x,
            n_samples=int(n_samples),
            seed=int(seed),
            device=models.device,
        )

        labels = CONFIG["ui"]["class_labels"]
        fig = fig_probability_bar(labels, mean_probs, std_probs)
        st.plotly_chart(fig, use_container_width=True)
        st.markdown(
            "<div class='caption'><b>Caption:</b> Predictive distribution estimated by repeated diffusion samples. "
            "Error bars represent sample standard deviation. "
            "This is not calibration; it is sampling variability under the model.</div>",
            unsafe_allow_html=True,
        )

        # Interpretation (neutral, not clinical)
        st.subheader("Interpretation (non-clinical)")
        top_idx = int(np.argmax(mean_probs))
        top_p = float(mean_probs[top_idx])

        entropy = float(-np.sum(mean_probs * np.log(mean_probs + 1e-10)))
        max_entropy = float(-np.log(1.0 / 3.0))
        norm_unc = 100.0 * entropy / max_entropy

        c1, c2, c3 = st.columns(3)
        with c1:
            st.metric("Most likely class", labels[top_idx])
        with c2:
            st.metric("Top-class probability", f"{top_p:.3f}")
        with c3:
            st.metric("Normalized entropy", f"{norm_unc:.1f}%")

        # Export
        export_dir = ensure_export_dir(CONFIG)
        if st.button("Export this figure + summary"):
            fig_out = export_dir / f"predictive_distribution_{g}.html"
            export_figure_html(fig, fig_out)

            notes = [
                f"Antibiotic selection shown: {antibiotic} (not used in inference unless model is conditioned).",
                "Sampling variability shown; calibration not assessed unless separately validated.",
            ]
            txt = build_report_summary_text(CONFIG, repro, notes)
            txt_out = export_dir / f"report_summary_{g}.txt"
            txt_out.write_text(txt, encoding="utf-8")

            st.success(f"Exported: {fig_out} and {txt_out}")

elif section == "Validation":
    st.header("Validation")
    st.write("This is where you prove you are not fooling yourself.")

    st.subheader(
        "Required sanity checks (you must implement offline and show here)")
    st.write(
        "- Same genome, same seed, same n_samples → identical output (or explain non-determinism).")
    st.write(
        "- Different seed → distribution should vary but mean should be stable within tolerance.")
    st.write(
        "- Input perturbation test: small embedding noise → bounded output change (sensitivity).")
    st.write(
        "- Failure case logging: detect NaN/Inf, out-of-range probs, shape mismatch.")

    st.subheader("Controls")
    st.write("- Negative control: shuffled embeddings should collapse performance.")
    st.write(
        "- Positive control: known resistant genotype subset should shift predicted distribution.")
    st.write(
        "- Baseline comparator outputs for same cases (rule-based / logistic regression).")

    st.subheader("What would invalidate these results")
    st.write(
        "- Evidence of leakage (same lineage in train/test) causing inflated AUROC.")
    st.write("- Poor calibration (high-confidence wrong predictions).")
    st.write("- Robustness simulation not matching real missingness patterns.")

elif section == "Limitations":
    st.header("Limitations")
    st.write("- Antibiotic conditioning is not implemented in this app unless your diffusion model explicitly takes it.")
    st.write(
        "- This dashboard does not establish clinical utility or calibration by default.")
    st.write("- Robustness curves depend on the realism of the corruption model.")
    st.write("- Reproducibility is best-effort; strict determinism may vary across machines without containerization.")

elif section == "References":
    st.header("References")
    st.write("Add real citations. No placeholders. Minimum expected:")
    st.write("- Dataset source(s) and accession info.")
    st.write("- AMRFinder reference.")
    st.write("- Masked autoencoder / denoising representation learning references.")
    st.write(
        "- Diffusion model reference(s) for conditional sampling and uncertainty.")
    st.write("- Evaluation metrics references (AUROC, PR-AUC, calibration metrics).")
