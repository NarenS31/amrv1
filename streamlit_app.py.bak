# =============================================================================
# TYPES
# =============================================================================
@dataclass(frozen=True)
class TransformRecord:
    name: str
    params: Dict[str, Any]
    rationale: str


@dataclass(frozen=True)
class TransformResult:
    x: np.ndarray
    log: List[TransformRecord]


@dataclass(frozen=True)
class DataArtifacts:
    embeddings: np.ndarray
    genome_ids: List[str]
    id_to_idx: Dict[str, int]
    comparison: Optional[pd.DataFrame]


@dataclass(frozen=True)
class ModelBundle:
    masked_ae: MaskedAutoencoder
    diffusion: ConditionalDiffusionModel
    schedule: DiffusionSchedule
    device: str


@dataclass(frozen=True)
class ReproInfo:
    git_commit: str
    python_version: str
    platform: str
    timestamp_utc: str
    seed: int
    file_hashes: Dict[str, str]
    package_versions: Dict[str, str]


# =============================================================================
# REPRODUCIBILITY + HASHING
# =============================================================================
def sha256_file(path: Path, chunk_size: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def get_git_commit_hash() -> str:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "HEAD"], stderr=subprocess.DEVNULL)
        return out.decode("utf-8").strip()
    except Exception:
        return "UNKNOWN (not a git repo)"


def get_package_versions(pkgs: Iterable[str]) -> Dict[str, str]:
    out: Dict[str, str] = {}
    for p in pkgs:
        try:
            out[p] = version(p)
        except PackageNotFoundError:
            out[p] = "NOT INSTALLED"
    return out


def build_repro_info(seed: int, tracked_files: List[Path]) -> ReproInfo:
    file_hashes = {str(p): (sha256_file(p) if p.exists() else "MISSING")
                   for p in tracked_files}
    pkgs = ["streamlit", "numpy", "pandas", "torch", "plotly"]
    return ReproInfo(
        git_commit=get_git_commit_hash(),
        python_version=sys.version.split()[0],
        platform=f"{platform.system()} {platform.release()} ({platform.machine()})",
        timestamp_utc=datetime.now(timezone.utc).isoformat(timespec="seconds"),
        seed=seed,
        file_hashes=file_hashes,
        package_versions=get_package_versions(pkgs),
    )


def render_repro_panel(info: ReproInfo) -> None:
    st.sidebar.markdown("## Reproducibility")
    st.sidebar.write(f"**Git commit:** {info.git_commit}")
    st.sidebar.write(f"**Python:** {info.python_version}")
    st.sidebar.write(f"**Platform:** {info.platform}")
    st.sidebar.write(f"**Run timestamp (UTC):** {info.timestamp_utc}")
    st.sidebar.write(f"**Global seed:** {info.seed}")

    with st.sidebar.expander("Package versions", expanded=False):
        for k, v in info.package_versions.items():
            st.write(f"- {k}: {v}")

    with st.sidebar.expander("Data / artifact hashes", expanded=False):
        for p, h in info.file_hashes.items():
            st.write(f"- {p}: `{h}`")


# =============================================================================
# DATA LOADING (RAW -> PROCESSED -> ANALYZED)
# =============================================================================
def load_genome_ids(path: Path) -> List[str]:
    with path.open("r", encoding="utf-8") as f:
        return [line.strip() for line in f if line.strip()]


def load_embeddings(path: Path) -> np.ndarray:
    arr = np.load(str(path))
    if arr.ndim != 2:
        raise ValueError(
            f"Expected 2D embeddings array, got shape={arr.shape}")
    return arr


def load_comparison_csv(path: Path) -> Optional[pd.DataFrame]:
    if not path.exists():
        return None
    return pd.read_csv(path)


def load_all_artifacts(cfg: Dict[str, Any]) -> DataArtifacts:
    data_dir = Path(cfg["paths"]["data_dir"])
    embeddings_path = data_dir / cfg["artifacts"]["embeddings_npy"]
    genome_ids_path = data_dir / cfg["artifacts"]["genome_ids_txt"]
    comparison_path = Path(cfg["artifacts"]["comparison_csv"])

    Z = load_embeddings(embeddings_path)
    genome_ids = load_genome_ids(genome_ids_path)

    if len(genome_ids) != Z.shape[0]:
        raise ValueError(
            f"Genome ID count ({len(genome_ids)}) != embeddings rows ({Z.shape[0]})")

    id_to_idx = {gid: i for i, gid in enumerate(
        genome_ids)}  # deterministic mapping
    comparison = load_comparison_csv(comparison_path)

    return DataArtifacts(embeddings=Z, genome_ids=genome_ids, id_to_idx=id_to_idx, comparison=comparison)


def transform_embedding(x: np.ndarray) -> TransformResult:
    log: List[TransformRecord] = []

    x2 = x.astype(np.float32, copy=True)
    log.append(
        TransformRecord(
            name="astype(float32)",
            params={},
            rationale="Enforce consistent dtype for torch inference.",
        )
    )

    if np.any(~np.isfinite(x2)):
        raise ValueError(
            "Embedding contains NaN/Inf; aborting to avoid silent corruption.")

    log.append(
        TransformRecord(
            name="finite_check",
            params={},
            rationale="Prevent silent propagation of NaN/Inf into probabilistic outputs.",
        )
    )

    return TransformResult(x=x2, log=log)


# =============================================================================
# MODELS + INFERENCE (DETERMINISTIC BEST-EFFORT)
# =============================================================================
@st.cache_resource
def load_models(cfg: Dict[str, Any]) -> ModelBundle:
    model_dir = Path(cfg["paths"]["model_dir"])
    device = "cpu"

    masked_ae = MaskedAutoencoder().to(device)
    masked_ae.load_state_dict(torch.load(
        model_dir / cfg["artifacts"]["masked_ae_weights"], map_location=device))
    masked_ae.eval()

    diffusion = ConditionalDiffusionModel().to(device)
    diffusion.load_state_dict(torch.load(
        model_dir / cfg["artifacts"]["diffusion_weights"], map_location=device))
    diffusion.eval()

    schedule = DiffusionSchedule(n_steps=int(
        cfg["diffusion"]["n_steps"])).to(device)
    return ModelBundle(masked_ae=masked_ae, diffusion=diffusion, schedule=schedule, device=device)


@torch.no_grad()
def sample_predictive_distribution(
    diffusion: ConditionalDiffusionModel,
    schedule: DiffusionSchedule,
    embedding: np.ndarray,
    n_samples: int,
    seed: int,
    device: str = "cpu",
) -> Tuple[np.ndarray, np.ndarray]:
    # Best-effort determinism
    torch.manual_seed(seed)
    np.random.seed(seed)

    x = torch.tensor(embedding, dtype=torch.float32, device=device)
    samples = diffusion.sample(x, schedule, n_samples=n_samples, device=device)

    mean_probs = samples.mean(dim=0).detach().cpu().numpy()
    std_probs = samples.std(dim=0).detach().cpu().numpy()

    if mean_probs.shape != (3,) or std_probs.shape != (3,):
        raise ValueError(
            f"Expected (3,) probs, got mean={mean_probs.shape}, std={std_probs.shape}")

    # Validate probabilities
    if np.any(mean_probs < -1e-6) or np.any(mean_probs > 1 + 1e-6):
        raise ValueError(
            "Mean probabilities out of [0,1] range; model output may be invalid.")
    return mean_probs, std_probs


# =============================================================================
# FIGURES (PLOTLY + CAPTIONS)
# =============================================================================
def fig_probability_bar(labels: List[str], mean_probs: np.ndarray, std_probs: np.ndarray) -> go.Figure:
    fig = go.Figure(
        data=[
            go.Bar(
                x=labels,
                y=mean_probs,
                error_y=dict(type="data", array=std_probs),
                text=[f"{p:.1%}" for p in mean_probs],
                textposition="outside",
            )
        ]
    )
    fig.update_layout(
        title="Predictive distribution over susceptibility classes",
        xaxis_title="Class",
        yaxis_title="Probability (unitless)",
        yaxis_range=[0, 1.1],
        height=420,
    )
    return fig


def fig_robustness(corruption: List[int], standard: List[float], masked: List[float]) -> go.Figure:
    fig = go.Figure()
    fig.add_trace(go.Scatter(x=corruption, y=standard,
                  mode="lines+markers", name="Standard AE AUROC"))
    fig.add_trace(go.Scatter(x=corruption, y=masked,
                  mode="lines+markers", name="Masked AE AUROC"))
    fig.update_layout(
        title="AUROC under simulated missingness",
        xaxis_title="Corruption (%)",
        yaxis_title="AUROC (unitless)",
        height=520,
        hovermode="x unified",
    )
    return fig


def fig_recall_by_antibiotic(comparison: pd.DataFrame) -> go.Figure:
    fig = go.Figure()
    fig.add_trace(go.Bar(name="AMRFinder recall",
                  x=comparison["antibiotic"], y=comparison["amrfinder_recall"]))
    fig.add_trace(go.Bar(name="Pipeline A recall",
                  x=comparison["antibiotic"], y=comparison["pipelineA_recall"]))
    fig.update_layout(
        title="Recall by antibiotic",
        xaxis_title="Antibiotic",
        yaxis_title="Recall (unitless)",
        barmode="group",
        height=520,
        hovermode="x unified",
    )
    return fig


# =============================================================================
# EXPORTS
# =============================================================================
def ensure_export_dir(cfg: Dict[str, Any]) -> Path:
    export_dir = Path(cfg["paths"]["export_dir"])
    export_dir.mkdir(parents=True, exist_ok=True)
    return export_dir


def export_table_csv(df: pd.DataFrame, export_path: Path) -> None:
    df.to_csv(export_path, index=False)


def export_figure_html(fig: go.Figure, export_path: Path) -> None:
    # HTML export is deterministic enough and avoids system deps.
    fig.write_html(str(export_path), include_plotlyjs="cdn")


def build_report_summary_text(cfg: Dict[str, Any], repro: ReproInfo, notes: List[str]) -> str:
    lines = []
    lines.append(f"{cfg['project']['name']} — Report Summary")
    lines.append(f"Run timestamp (UTC): {repro.timestamp_utc}")
    lines.append(f"Git commit: {repro.git_commit}")
    lines.append(f"Python: {repro.python_version}")
    lines.append("")
    lines.append("Methods (high level):")
    lines.append(
        "- Masked autoencoder representation learning for robustness to missingness.")
    lines.append(
        "- Conditional diffusion sampling to estimate predictive distribution over S/I/R.")
    lines.append("- Deterministic seeding used for sampling (best-effort).")
    lines.append("")
    lines.append("Notes / caveats:")
    for n in notes:
        lines.append(f"- {n}")
    return "\n".join(lines)


